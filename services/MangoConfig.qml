pragma Singleton
pragma ComponentBehavior: Bound

import QtQuick
import Quickshell
import Quickshell.Io
import qs.modules.common
import qs.modules.common.functions
import qs.services

/**
 * MangoWM counterpart of HyprlandConfig / NiriConfig.
 *
 * Mango reads a single flat `key=value` file. The shell never edits the user's
 * `~/.config/mango/config.conf` on its own; instead it writes managed options to
 * `~/.config/mango/qssettings/shell.conf` and the user adds one include line at
 * the end of their config (the Settings page offers to do that):
 *
 *     source_optional=/home/<user>/.config/mango/qssettings/shell.conf
 *
 * Values are persisted as JSON in `qssettings/settings.json`, and the generated
 * shell.conf is regenerated from it. On first run the current values found in
 * config.conf seed the JSON, so the UI shows the real configuration.
 */
Singleton {
    id: root

    property alias options: adapter
    property bool ready: false
    property int readWriteDelay: 300
    property bool _seeded: false
    property bool _needSeed: false

    readonly property bool active: WM.compositor === "mango"

    readonly property string configPath: FileUtils.trimFileProtocol(`${Directories.config}/mango/config.conf`)
    readonly property string qssettingsDir: FileUtils.trimFileProtocol(`${Directories.config}/mango/qssettings`)
    readonly property string settingsPath: `${qssettingsDir}/settings.json`
    readonly property string shellConfPath: `${qssettingsDir}/shell.conf`

    // Must go at the END of config.conf so these values win over earlier lines.
    readonly property string includeLine: `source_optional=${shellConfPath}`
    readonly property string generatedHeader: "# ! AUTO-GENERATED by the shell settings app — do not edit, changes will be overwritten\n\n"

    // [group, json property, mango key, type]
    readonly property var mappings: [
        ["appearance", "gapInnerHorizontal", "gap_inner_horizontal", "int"],
        ["appearance", "gapInnerVertical", "gap_inner_vertical", "int"],
        ["appearance", "gapOuterHorizontal", "gap_outer_horizontal", "int"],
        ["appearance", "gapOuterVertical", "gap_outer_vertical", "int"],
        ["appearance", "borderPx", "border_px", "int"],
        ["appearance", "borderRadius", "border_radius", "int"],
        ["appearance", "noBorderWhenSingle", "no_border_when_single", "bool"],
        ["appearance", "focusedOpacity", "focused_opacity", "real"],
        ["appearance", "unfocusedOpacity", "unfocused_opacity", "real"],

        ["effects", "blur", "blur", "bool"],
        ["effects", "blurLayer", "blur_layer", "bool"],
        ["effects", "blurPasses", "blur_params_num_passes", "int"],
        ["effects", "blurRadius", "blur_params_radius", "int"],
        ["effects", "blurNoise", "blur_params_noise", "real"],
        ["effects", "blurSaturation", "blur_params_saturation", "real"],
        ["effects", "shadows", "shadows", "bool"],
        ["effects", "shadowSize", "shadows_size", "int"],
        ["effects", "shadowBlur", "shadows_blur", "int"],

        ["animations", "enable", "animations", "bool"],
        ["animations", "layerAnimations", "layer_animations", "bool"],
        ["animations", "openType", "animation_type_open", "string"],
        ["animations", "closeType", "animation_type_close", "string"],
        ["animations", "durationOpen", "animation_duration_open", "int"],
        ["animations", "durationClose", "animation_duration_close", "int"],
        ["animations", "durationTag", "animation_duration_tag", "int"],

        ["layout", "newIsMaster", "new_is_master", "bool"],
        ["layout", "masterFactor", "default_master_factor", "real"],
        ["layout", "masterCount", "default_master_count", "int"],
        ["layout", "smartGaps", "smart_gaps", "bool"],
        ["layout", "scrollerProportion", "scroller_default_proportion", "real"],
        ["layout", "scrollerFocusCenter", "scroller_focus_center", "bool"],
        ["layout", "scrollerPreferCenter", "scroller_prefer_center", "bool"],
        ["layout", "dwindleSmartSplit", "dwindle_smart_split", "bool"],
        ["layout", "dwindlePreserveSplit", "dwindle_preserve_split", "bool"],

        ["input", "repeatRate", "repeat_rate", "int"],
        ["input", "repeatDelay", "repeat_delay", "int"],
        ["input", "numlock", "numlock_on", "bool"],
        ["input", "xkbLayout", "xkb_rules_layout", "string"],
        ["input", "tapToClick", "tap_to_click", "bool"],
        ["input", "tapAndDrag", "tap_and_drag", "bool"],
        ["input", "dragLock", "drag_lock", "bool"],
        ["input", "trackpadNatural", "trackpad_natural_scrolling", "bool"],
        ["input", "trackpadDisableWhileTyping", "trackpad_disable_while_typing", "bool"],
        ["input", "disableTrackpad", "disable_trackpad", "bool"],
        ["input", "mouseNatural", "mouse_natural_scrolling", "bool"],

        ["misc", "warpCursor", "warp_cursor", "bool"],
        ["misc", "focusOnActivate", "focus_on_activate", "bool"],
        ["misc", "sloppyFocus", "sloppy_focus", "bool"],
        ["misc", "focusCrossMonitor", "focus_cross_monitor", "bool"],
        ["misc", "focusCrossTag", "focus_cross_tag", "bool"],
        ["misc", "floatingSnap", "enable_floating_snap", "bool"],
        ["misc", "snapDistance", "snap_distance", "int"],
        ["misc", "cursorSize", "cursor_size", "int"],
        ["misc", "dragTileToTile", "drag_tile_to_tile", "bool"],
        ["misc", "dragTileSmall", "drag_tile_small", "bool"],

        ["overview", "gapInner", "overview_gap_inner", "int"],
        ["overview", "gapOuter", "overview_gap_outer", "int"],
        ["overview", "enableHotarea", "enable_hotarea", "bool"],
        ["overview", "hotareaSize", "hotarea_size", "int"],
    ]

    Component.onCompleted: {
        if (!root.active) return;
        Quickshell.execDetached(["mkdir", "-p", root.qssettingsDir])
    }

    function parseKeys(text) {
        const result = {};
        for (const rawLine of String(text ?? "").split("\n")) {
            const line = rawLine.trim();
            if (line === "" || line.startsWith("#")) continue;
            const eq = line.indexOf("=");
            if (eq <= 0) continue;
            const key = line.slice(0, eq).trim();
            const value = line.slice(eq + 1).trim();
            if (key !== "") result[key] = value;
        }
        return result;
    }

    function toPropertyValue(value, type) {
        if (type === "bool") return !(["0", "false", "no", "off"].includes(String(value).toLowerCase()));
        if (type === "int") return Math.round(Number(value));
        if (type === "real") return Number(value);
        return String(value);
    }

    function toConfigValue(value, type) {
        if (type === "bool") return value ? "1" : "0";
        return String(value);
    }

    // Copy current values from the user's config.conf into the adapter.
    // Only used when settings.json did not exist yet, so the UI starts from the
    // user's real configuration instead of our defaults.
    function seedFromUserConfig() {
        if (root._seeded) return;
        const text = String(userConfigFile.text ?? "");
        if (text.trim() === "") return; // config not loaded yet, try again later
        root._seeded = true;
        const values = root.parseKeys(text);
        for (const [group, prop, key, type] of root.mappings) {
            const raw = values[key];
            if (raw === undefined) continue;
            const parsed = root.toPropertyValue(raw, type);
            if (type === "string") {
                if (parsed !== "") adapter[group][prop] = parsed;
            } else if (!Number.isNaN(parsed)) {
                adapter[group][prop] = parsed;
            }
        }
        root.generateShellConf();
    }

    function generateShellConf() {
        if (!root.active) return;
        let conf = root.generatedHeader;
        for (const [group, prop, key, type] of root.mappings)
            conf += `${key}=${root.toConfigValue(adapter[group][prop], type)}\n`;
        // Cursor theme/size are managed by scripts/system-appearance.sh, which writes
        // its own small include here. Mango supports nested `source_optional`.
        conf += `\nsource_optional=${qssettingsDir}/cursor.conf\n`;
        shellConfFile.setText(conf);
    }

    function applyLive() {
        if (WM.compositor !== "mango") return;
        Quickshell.execDetached(["mmsg", "dispatch", "reload_config"])
    }

    Timer {
        id: fileWriteTimer
        interval: root.readWriteDelay
        onTriggered: {
            settingsFileView.writeAdapter();
            root.generateShellConf();
            root.applyLive();
        }
    }

    FileView {
        id: userConfigFile
        path: root.configPath
        watchChanges: true
        onFileChanged: reload()
        onLoaded: {
            if (root._needSeed)
                root.seedFromUserConfig()
        }
    }

    FileView {
        id: shellConfFile
        path: root.shellConfPath
    }

    FileView {
        id: settingsFileView
        path: root.settingsPath
        watchChanges: true
        onFileChanged: reload()
        onAdapterUpdated: fileWriteTimer.restart()
        onLoaded: {
            root.ready = true
            root.generateShellConf()
        }
        onLoadFailed: error => {
            if (!root.active) return;
            if (error == FileViewError.FileNotFound) {
                root._needSeed = true
                root.seedFromUserConfig()
                writeAdapter()
                root.generateShellConf()
                root.ready = true
            }
        }

        JsonAdapter {
            id: adapter

            property JsonObject appearance: JsonObject {
                property int gapInnerHorizontal: 5
                property int gapInnerVertical: 5
                property int gapOuterHorizontal: 10
                property int gapOuterVertical: 10
                property int borderPx: 4
                property int borderRadius: 6
                property bool noBorderWhenSingle: false
                property real focusedOpacity: 1.0
                property real unfocusedOpacity: 1.0
            }

            property JsonObject effects: JsonObject {
                property bool blur: true
                property bool blurLayer: true
                property int blurPasses: 2
                property int blurRadius: 5
                property real blurNoise: 0.02
                property real blurSaturation: 1.2
                property bool shadows: false
                property int shadowSize: 10
                property int shadowBlur: 15
            }

            property JsonObject animations: JsonObject {
                property bool enable: true
                property bool layerAnimations: true
                property string openType: "slide"
                property string closeType: "slide"
                property int durationOpen: 400
                property int durationClose: 800
                property int durationTag: 350
            }

            property JsonObject layout: JsonObject {
                property bool newIsMaster: true
                property real masterFactor: 0.55
                property int masterCount: 1
                property bool smartGaps: false
                property real scrollerProportion: 0.8
                property bool scrollerFocusCenter: false
                property bool scrollerPreferCenter: false
                property bool dwindleSmartSplit: false
                property bool dwindlePreserveSplit: false
            }

            property JsonObject input: JsonObject {
                property int repeatRate: 25
                property int repeatDelay: 600
                property bool numlock: false
                property string xkbLayout: "us"
                property bool tapToClick: true
                property bool tapAndDrag: true
                property bool dragLock: true
                property bool trackpadNatural: false
                property bool trackpadDisableWhileTyping: true
                property bool disableTrackpad: false
                property bool mouseNatural: false
            }

            property JsonObject misc: JsonObject {
                property bool warpCursor: true
                property bool focusOnActivate: true
                property bool sloppyFocus: true
                property bool focusCrossMonitor: false
                property bool focusCrossTag: false
                property bool floatingSnap: false
                property int snapDistance: 30
                property int cursorSize: 24
                property bool dragTileToTile: true
                property bool dragTileSmall: true
            }

            property JsonObject overview: JsonObject {
                property int gapInner: 5
                property int gapOuter: 30
                property bool enableHotarea: false
                property int hotareaSize: 10
            }
        }
    }
}
